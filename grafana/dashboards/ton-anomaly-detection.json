      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT round(max(tps)::numeric, 1) AS max_tps FROM block_metrics WHERE $__timeFilter(\"timestamp\")",
        "format": "table",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Avg Block Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT round(avg(block_time)::numeric, 2) AS avg_block_time FROM block_metrics WHERE $__timeFilter(\"timestamp\")",
