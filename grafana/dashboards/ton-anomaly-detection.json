{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Transactions Per Second (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT\n  $__timeGroup(\"timestamp\", '5m') AS time,\n  avg(tps) AS avg_tps,\n  max(tps) AS max_tps\nFROM block_metrics\nWHERE\n  $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "ops"
        }
      }
    },
    {
      "title": "Transaction Count per Block",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT\n  $__timeGroup(\"timestamp\", '5m') AS time,\n  avg(transaction_count) AS avg_tx,\n  max(transaction_count) AS max_tx\nFROM block_metrics\nWHERE\n  $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Block Time (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT\n  $__timeGroup(\"timestamp\", '5m') AS time,\n  avg(block_time) AS avg_block_time,\n  max(block_time) AS max_block_time\nFROM block_metrics\nWHERE\n  $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "s"
        }
      }
    },
    {
      "title": "Unique Addresses per Block",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT\n  $__timeGroup(\"timestamp\", '5m') AS time,\n  avg(unique_addresses) AS avg_addrs,\n  max(unique_addresses) AS max_addrs\nFROM block_metrics\nWHERE\n  $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Gas Used (Total Fees, TON)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT\n  $__timeGroup(\"timestamp\", '5m') AS time,\n  avg(total_gas_used::float / 1e9) AS avg_gas_ton\nFROM block_metrics\nWHERE\n  $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "External vs Internal Messages",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT\n  $__timeGroup(\"timestamp\", '5m') AS time,\n  avg(external_msg_count) AS external_msgs,\n  avg(internal_msg_count) AS internal_msgs\nFROM block_metrics\nWHERE\n  $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Total Blocks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "uid": "P40AE60E18F02DE32" },
      "targets": [{
        "rawSql": "SELECT count(*) AS total_blocks FROM block_metrics WHERE $__timeFilter(\"timestamp\")",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "title": "Avg TPS",
